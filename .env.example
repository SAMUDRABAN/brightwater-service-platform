# Optional native ElevenLabs engineering candidate. Dedicated evaluation DB only.
BW_MANAGED_ENABLED=false
BW_MANAGED_AGENT_ID=
BW_MANAGED_API_KEY=
BW_MANAGED_WEBHOOK_SECRET=
BW_MANAGED_DATABASE_URL=

# Automatic UK reminders: off until the separate UK native route is qualified.
BW_CAMPAIGN_GATEWAY_URL=
BW_CAMPAIGN_GATEWAY_TOKEN=
BW_CAMPAIGN_ROUTE_VERIFIED=false
BW_CAMPAIGN_DAILY_LIMIT=20
BW_MANAGED_CAMPAIGN_AGENT_ID=
BW_REPLACEMENT_QUOTE_AGE_YEARS=15
# A GB gateway uses BW_GATEWAY_COUNTRY=GB, an approved +44 caller ID,
# BW_GATEWAY_CAMPAIGN_ENABLED=true and BW_VOICE_BACKEND=elevenlabs.
# Never enable campaigns on the IN attended-test gateway.
