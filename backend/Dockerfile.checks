FROM ghcr.io/astral-sh/uv:0.11.19 AS uv
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --extra dev --extra voice --no-install-project
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./
COPY tests ./tests
RUN uv sync --frozen --extra dev --extra voice && useradd --create-home --uid 10001 app
USER app
CMD ["pytest", "-q"]
