{
    email {$BW_TLS_EMAIL}
    admin off
}

{$BW_WEB_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
    reverse_proxy web:3000
}

{$BW_API_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    # Authenticated operator/runtime paths remain enforced by FastAPI.
    # Metrics are accessed through SSH on the Docker network, never published.
    @blocked path /metrics /docs /redoc /openapi.json
    respond @blocked 404
    reverse_proxy api:8787
}
